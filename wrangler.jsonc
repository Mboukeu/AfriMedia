{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afrimedia",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afrimedia-db",
      "database_id": "be941346-c312-41ff-816b-6ad2fdb66465",
      "migrations_dir": "migrations"
    }
  ]
}
