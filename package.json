{
  "name": "afrimedia",
  "version": "3.0.0",
  "private": true,
  "description": "AfriMedia - plateforme média et services sur Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply afrimedia-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply afrimedia-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}